# Anthropic
ANTHROPIC_API_KEY=

# Twitter/X API v2 (bearer token, app-only auth is enough for recent search)
TWITTER_BEARER_TOKEN=

# Reddit (no auth required for public search.json endpoint, but a
# descriptive User-Agent is required by Reddit's API rules)
REDDIT_USER_AGENT=gtmteam-radar/0.1 (by /u/yourname)

# LinkedIn has no usable public search/post API for this use case.
# See src/sources/linkedin.ts for details on the stub.
